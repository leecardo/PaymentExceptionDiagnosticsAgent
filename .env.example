# Copy to .env for local development. Values here are safe local defaults only.

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payment_diagnostics
POSTGRES_USER=payment_diagnostics
POSTGRES_PASSWORD=change-me-local-only
PAYMENT_DIAGNOSTICS_POSTGRES_PORT=5432

# Spring services
API_SERVER_PORT=8080
MCP_SERVER_PORT=8081

# Frontend dev server
VITE_API_BASE_URL=http://localhost:8080
VITE_MCP_BASE_URL=http://localhost:8081

# LLM / embedding provider placeholders. Never commit real keys.
LLM_PROVIDER=placeholder
LLM_API_KEY=replace-with-local-secret
EMBEDDING_MODEL=text-embedding-placeholder
EMBEDDING_DIMENSIONS=1536

# MCP client/server shared placeholder. Never commit real secrets.
MCP_SHARED_SECRET=replace-with-local-secret
